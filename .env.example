DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=True

# PostgreSQL em produção. Deixe vazio apenas no desenvolvimento com SQLite.
DATABASE_URL=
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_DB_SSL_REQUIRED=True
REDIS_URL=
NKATA_CACHE_KEY_PREFIX=nkata

# URL pública do frontend React. É usada nos links enviados por email e no Admin.
NKATA_FRONTEND_URL=http://localhost:5173

# Em desenvolvimento pode ficar vazio. Com DEBUG=True, o Django aceita a rede local.
# Em produção, defina apenas os domínios reais.
DJANGO_ALLOWED_HOSTS=

# Em desenvolvimento pode ficar True para testar no computador e no telemóvel.
# Em produção deve ser False e CORS_ALLOWED_ORIGINS deve listar apenas os domínios autorizados.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Para login e outras ações POST, inclua aqui o endereço exato usado no navegador.
# Exemplo para telemóvel: http://192.168.0.100:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Validade do link de recuperação de palavra-passe, em segundos. 3600 = 1 hora.
DJANGO_PASSWORD_RESET_TIMEOUT=3600

# Pré-moderação automática de fotografia/vídeo.
# manual = não usa classificador externo; QR e metadados continuam verificados localmente.
# openai = imagens e frames extraídos dos vídeos são pré-classificados pelo Moderation API.
NKATA_MEDIA_MODERATION_PROVIDER=manual
NKATA_OPENAI_MODERATION_MODEL=omni-moderation-latest
NKATA_MEDIA_MODERATION_TIMEOUT=20
OPENAI_API_KEY=

# Inspeção visual opcional para detectar telefone/WhatsApp, email, @username,
# links, publicidade e oferta/solicitação de serviços sexuais visíveis na media.
# Continua sendo apenas pré-moderação: nunca aprova automaticamente.
NKATA_MEDIA_VISION_SCAN_ENABLED=False
NKATA_MEDIA_VISION_MODEL=gpt-5.6-luna
NKATA_MEDIA_VISION_MAX_IMAGES=4

# WebRTC.
# STUN tem um valor público padrão no settings.py e pode ser substituído aqui.
# TURN deve ser configurado em produção para chamadas mais confiáveis em redes móveis/NAT/firewalls.
NKATA_WEBRTC_STUN_URLS=stun:stun.cloudflare.com:3478
NKATA_WEBRTC_TURN_URLS=
NKATA_WEBRTC_TURN_USERNAME=
NKATA_WEBRTC_TURN_CREDENTIAL=
NKATA_WEBRTC_TURN_SHARED_SECRET=
NKATA_WEBRTC_TURN_CREDENTIAL_TTL=3600

# Notificações Push da aplicação instalável (PWA).
# Gere uma vez com: python manage.py generate_vapid_keys
# Copie o par apresentado para o ambiente de produção e nunca publique a chave privada.
NKATA_WEBPUSH_PUBLIC_KEY=
NKATA_WEBPUSH_PRIVATE_KEY=
NKATA_WEBPUSH_SUBJECT=mailto:suporte@nkata.online
NKATA_WEBPUSH_TTL=300

# Exemplo genérico de TURN próprio/coturn:
# NKATA_WEBRTC_TURN_URLS=turn:turn.seudominio.com:3478?transport=udp,turns:turn.seudominio.com:5349?transport=tcp
# NKATA_WEBRTC_TURN_USERNAME=usuario-temporario
# NKATA_WEBRTC_TURN_CREDENTIAL=credencial-temporaria
# Para coturn com use-auth-secret, prefira NKATA_WEBRTC_TURN_SHARED_SECRET.
# O backend gera credenciais temporárias por membro e não publica o segredo.

# Armazenamento privado S3 compatível. Em produção, use um bucket privado.
# Se ficar vazio, os ficheiros ficam no disco local e precisam de volume persistente.
NKATA_STORAGE_BUCKET=
NKATA_STORAGE_REGION=
NKATA_STORAGE_ENDPOINT_URL=
NKATA_STORAGE_ACCESS_KEY=
NKATA_STORAGE_SECRET_KEY=
NKATA_STORAGE_OPTIONS={}
NKATA_PRIVATE_MEDIA_ROOT=private_media

# Em desenvolvimento, os emails aparecem no terminal do Django.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=NKATA <no-reply@nkata.local>

# Em produção, altere o backend para django.core.mail.backends.smtp.EmailBackend
# e preencha os dados do fornecedor de email.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_TIMEOUT=15

SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=False

# Limites por conta/IP. Os valores abaixo já são os padrões do projeto.
NKATA_THROTTLE_ANON=120/min
NKATA_THROTTLE_USER=1200/min
NKATA_THROTTLE_LOGIN=10/min
NKATA_THROTTLE_PASSWORD_RESET=5/hour
NKATA_THROTTLE_ACCESS_REQUEST=3/hour
NKATA_THROTTLE_ACCESS_STATUS=30/hour
NKATA_THROTTLE_TOKEN_FLOW=60/hour
NKATA_MAX_REQUEST_BODY_SIZE=69206016

# Segurança HTTPS de produção. Só ative preload depois de confirmar todos os subdomínios.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
NKATA_TRUST_PROXY_HEADERS=False
DJANGO_LOG_LEVEL=INFO
