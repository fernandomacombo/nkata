# Reference template. Replace hostname and install a valid TLS certificate first.
# Include in the http context of Nginx on the isolated staging SFU host.
server {
    listen 443 ssl;
    server_name MEDIA_STAGING_HOSTNAME;
    ssl_certificate /etc/letsencrypt/live/MEDIA_STAGING_HOSTNAME/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/MEDIA_STAGING_HOSTNAME/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /signal {
        proxy_pass http://127.0.0.1:8085;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_read_timeout 125s;
        proxy_send_timeout 10s;
        access_log off;
    }

    location / { return 404; }
}
