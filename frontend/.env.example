# Opcional: define manualmente o endereço do backend Django.
# No computador:
# VITE_API_BASE_URL=http://127.0.0.1:8000
#
# No telemóvel, o modo HTTPS recomendado é preparado automaticamente por:
# powershell -ExecutionPolicy Bypass -File ..\scripts\setup-dev-https.ps1
# Esse comando cria frontend/.env.https sem fixar o endereço da API: /api usa
# sempre a mesma origem aberta no navegador e é encaminhado pelo Vite ao Django.
# VITE_PUBLIC_APP_ORIGIN continua a usar o IP da rede local apenas no QR, pois
# localhost no telemóvel apontaria para o próprio aparelho.

VITE_API_BASE_URL=
VITE_PUBLIC_APP_ORIGIN=

# Alvo interno do proxy Vite no modo HTTPS. Normalmente não precisa alterar.
NKATA_DEV_API_TARGET=http://127.0.0.1:8000

# Opcional: substitui as imagens locais do hero por outros endereços.
# Sem estes valores, a aplicação usa os ficheiros de frontend/public/images/.
VITE_HERO_DESKTOP_IMAGE_URL=
VITE_HERO_MOBILE_IMAGE_URL=

# Segurança e transparência:
# perfis fictícios ficam desligados por padrão. Ative somente numa demonstração
# local e nunca no ambiente público.
VITE_ENABLE_DEMO_PROFILES=false
