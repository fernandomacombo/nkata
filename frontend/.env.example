# Opcional: define manualmente o endereço do backend Django.
# No computador:
# VITE_API_BASE_URL=http://127.0.0.1:8000
#
# No telemóvel, usando a mesma rede Wi-Fi:
# VITE_API_BASE_URL=http://192.168.0.100:8000

VITE_API_BASE_URL=

# Opcional: substitui as imagens locais do hero por outros endereços.
# Sem estes valores, a aplicação usa os ficheiros de frontend/public/images/.
VITE_HERO_DESKTOP_IMAGE_URL=
VITE_HERO_MOBILE_IMAGE_URL=

# Segurança e transparência:
# perfis fictícios ficam desligados por padrão. Ative somente numa demonstração
# local e nunca no ambiente público.
VITE_ENABLE_DEMO_PROFILES=false
