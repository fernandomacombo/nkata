{
  "name": "nkata-frontend",
  "version": "0.1.0",
  "private": true,
  "author": "Fernando Macombo",
  "contributors": [
    "Fernando Macombo"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:https": "vite --mode https --host 0.0.0.0 --port 5173",
    "test:api-runtime": "node --test scripts/test-api-runtime.mjs",
    "test:nkata-id": "node --test scripts/test-nkata-id-runtime.mjs",
    "check:ui": "node scripts/check-ui-policy.mjs",
    "build": "npm run check:ui && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "lucide-react": "1.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "vite": "8.2.0",
    "tailwindcss": "3.4.17",
    "postcss": "8.5.25",
    "autoprefixer": "10.4.20"
  },
  "overrides": {
    "nanoid": "3.3.17"
  }
}
